# Optional server-only values. Never use NEXT_PUBLIC_ for API secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Ollama runs on your PC. localhost works only for local development.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:3b
# Production: HTTPS URL of the authenticated bridge, never raw Ollama.
OLLAMA_BRIDGE_TOKEN=
